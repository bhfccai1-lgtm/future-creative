{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.7.3"
      ],
      "env": {}
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--executable-path",
        "/opt/pw-browsers/chromium",
        "--viewport-size",
        "1360,900",
        "--output-dir",
        "/tmp/playwright-mcp"
      ],
      "env": {}
    }
  }
}
