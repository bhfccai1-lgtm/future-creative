# ───────── FUTURE CREATIVE AI PUBLISHING SYSTEM — environment ─────────
# Copy to .env and fill in. NEVER commit .env. Secrets can also be entered (encrypted) from the dashboard.

# Public URL of the dashboard (used for signed media links that the publishing provider downloads)
PUBLIC_BASE_URL=https://ads.example.bh
DOMAIN=ads.example.bh
ACME_EMAIL=admin@example.bh

# Database (docker compose builds DATABASE_URL from these)
POSTGRES_USER=fc
POSTGRES_PASSWORD=          # openssl rand -hex 24
POSTGRES_DB=fcap
# For running outside docker:
# DATABASE_URL=postgresql://fc:password@localhost:5432/fcap
# REDIS_URL=redis://localhost:6379

# Security — generate fresh values:
APP_ENCRYPTION_KEY=         # openssl rand -hex 32   (64 hex chars; encrypts stored API keys/tokens)
SESSION_SECRET=             # openssl rand -base64 48
COOKIE_SECURE=true
WEBHOOK_SECRET=             # optional; enables /api/webhooks/provider (HMAC-SHA256)

# Media storage: local (docker volume) or s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/data/media
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=future-creative-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Optional — can instead be set from the dashboard (stored AES-256-GCM encrypted in the database)
OPENAI_API_KEY=
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BASE_URL=https://app.metricool.com/api

# Rendering
FONT_DIR=./assets/fonts
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_CONCURRENCY=2

# First administrator (used by: docker compose run --rm web npm run admin:create)
ADMIN_EMAIL=
ADMIN_PASSWORD=
