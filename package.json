{
  "name": "future-creative-ai-publishing",
  "version": "9.1.0",
  "private": true,
  "description": "FUTURE CREATIVE AI PUBLISHING SYSTEM — مطبعة إبداع المستقبل",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts",
    "preview:render": "tsx scripts/render-preview.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.79.0",
    "next": "^15.5.29",
    "openai": "^7.64.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo-google-fonts/noto-sans-malayalam": "^0.4.2",
    "@expo-google-fonts/tajawal": "^0.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.7",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "@prisma/config": {
      "effect": "3.22.5"
    }
